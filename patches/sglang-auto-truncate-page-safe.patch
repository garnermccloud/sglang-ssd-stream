+    def max_schedulable_input_len(self) -> int:
+        """Largest prompt whose page-rounded allocation leaves one output token."""
+        token_budget = (
+            self.max_total_num_tokens * get_parallel().attn_dcp_size
+        )
+        max_rounded_input_len = token_budget - self.page_size - 2
+        if max_rounded_input_len <= 0:
+            return 0
+        return min(
+            self.max_req_input_len,
+            (max_rounded_input_len // self.page_size) * self.page_size,
+        )
